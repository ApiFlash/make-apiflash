[
	{
		"name": "url",
		"type": "text",
		"label": "URL",
		"required": true,
		"help": "Enter a path relative to `https://api.apiflash.com`. For example: `/v1/urltoimage/quota`. Your access key is added automatically. See the [ApiFlash documentation](https://apiflash.com/documentation) for the available endpoints."
	},
	{
		"name": "method",
		"type": "select",
		"label": "Method",
		"required": true,
		"default": "GET",
		"options": [
			{
				"label": "GET",
				"value": "GET"
			},
			{
				"label": "POST",
				"value": "POST"
			}
		]
	},
	{
		"name": "headers",
		"type": "array",
		"label": "Headers",
		"spec": [
			{
				"name": "key",
				"type": "text",
				"label": "Key"
			},
			{
				"name": "value",
				"type": "text",
				"label": "Value"
			}
		]
	},
	{
		"name": "qs",
		"type": "array",
		"label": "Query String",
		"help": "Request parameters, for example `url` and `format` for `/urltoimage`.",
		"spec": [
			{
				"name": "key",
				"type": "text",
				"label": "Key"
			},
			{
				"name": "value",
				"type": "text",
				"label": "Value"
			}
		]
	}
]
